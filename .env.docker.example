# 容器编排专用环境变量(issue #36)。用法:
#   cp .env.docker.example .env.docker   # 按需修改
#   docker compose --env-file .env.docker up -d --build
#
# 说明:本文件的值经 compose 插值进入容器;留空的项走 docker-compose.yml 内默认值。
# 与 server/.env(本地 npm 开发用)互不影响;.env.docker 含密钥,已在 .gitignore 中排除。

# ---------- LLM 选型:mock | siliconflow | ollama ----------
# mock:零依赖,链路自检用;siliconflow:需填 Key;ollama:需 --profile llm-local 起 ollama
LLM_PROVIDER=mock
# SiliconFlow 免费池排队严重,慢模型实测需 3 分钟级超时;换付费/快模型可适当下调
LLM_TIMEOUT_MS=180000

# ---------- SiliconFlow(https://cloud.siliconflow.cn 申请)----------
SILICONFLOW_API_KEY=
# 实测首 token 最快:THUDM/GLM-4-9B-0414(约 0.2~0.8s);默认模型较慢
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# ---------- Ollama(容器内服务名 ollama;宿主机直连改 http://host.docker.internal:11434)----------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3
# 模型常驻内存时长,避免每次请求 30s+ 冷启动载入
OLLAMA_KEEP_ALIVE=24h

# ---------- RAG ----------
RAG_HYBRID=1
RAG_TOPK=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ---------- 会话 ----------
CHAT_HISTORY_TURNS=6
CHAT_SESSION_TTL_MS=1800000
CHAT_QUESTION_MAX=500

# ---------- 宿主端口与 postgres(仅 --profile db 时使用;#29 接入前不参与运行)----------
APP_PORT=3000
PG_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=shijiazhuang

# ---------- 连接鉴权(issue #61)----------
# 留空 = 不鉴权(仅本机 demo);上线必须设置为随机字符串,并与构建期 VITE_WS_TOKEN 一致
WS_TOKEN=
