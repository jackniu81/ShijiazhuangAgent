# ── LLM ──────────────────────────────────────────
# mock(默认,无需外部依赖) | siliconflow | ollama
# 取值非法、或选了 siliconflow 但缺 SILICONFLOW_API_KEY 时:自动回退 mock 并打 warn 日志(issue #27)
LLM_PROVIDER=mock
# 单次 LLM 请求超时(毫秒);连接失败/5xx 会自动重试一次(已产出 token 的流式不重试)
# 默认 180000:issue #27 实测 SiliconFlow 免费池 chat 首 token 45~81s、plan 全程 ~163s,60s 会超时失败
LLM_TIMEOUT_MS=180000

# SiliconFlow(云端,provider=siliconflow 时生效)
# Key 在 https://cloud.siliconflow.cn 免费创建;缺 Key 时启动自动回退 mock(见上方说明)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# Ollama(本地,provider=ollama 时生效)
# 前提:本机已运行 `ollama serve`,且已 pull 下方两个模型,否则启动建索引/问答会报错:
#   ollama pull qwen2.5:7b && ollama pull bge-m3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# ── RAG ──────────────────────────────────────────
# 默认指向仓库根 data/;跨目录部署时用绝对路径覆盖
DATA_DIR=
RAG_TOPK=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
# BM25+向量混合检索(RRF),0 关闭退回纯向量
RAG_HYBRID=1
# 向量存储后端(issue #29):memory(默认,进程内) | pgvector(Postgres 持久化)
RAG_STORE_BACKEND=memory
# backend=pgvector 时必填,例:postgres://user:pass@localhost:5432/agent
# 需目标库已启用 pgvector 扩展(compose 的 pgvector/pgvector:pg18 已内置)
DATABASE_URL=
# 向量维度,须与 embedder 输出一致:bge-m3=1024(默认),mock=256
RAG_VECTOR_DIM=1024
# 向量表名,默认 rag_chunks
RAG_VECTOR_TABLE=rag_chunks

# ── 会话 ─────────────────────────────────────────
# 携带的历史对话轮数(每轮 = 一问一答)
CHAT_HISTORY_TURNS=6
# 闲置会话回收时间(毫秒),默认 30 分钟
CHAT_SESSION_TTL_MS=1800000
# 提问最大长度,超出报 INVALID_INPUT
CHAT_QUESTION_MAX=500

# ── 生成参数(issue #86)───────────────────────
# 问答采样温度,默认 0.7(兼顾流畅与事实性);非正数或非法值回退默认
CHAT_TEMPERATURE=0.7
# 单次回答生成 token 上限,默认 2048,防成本失控
CHAT_MAX_TOKENS=2048
# 行程生成参数:plan 输出为结构化 JSON,低温采样保稳定(建议 ≤ 0.3)
PLAN_TEMPERATURE=0.2
# 行程 JSON 较长(7 天行程),上限默认 4096
PLAN_MAX_TOKENS=4096

# ── WebSocket 限流(issue #62)──────────────────────
# 同一会话允许同时进行的活跃请求数,默认 1(超出回 app:error RATE_LIMITED)
WS_MAX_CONCURRENT_PER_SESSION=1
# 滑动窗口内每个 IP / 每个会话的最大请求数(默认 30,宽松)
WS_RATE_LIMIT_PER_WINDOW=30
# 滑动窗口长度(毫秒),默认 60000
WS_RATE_LIMIT_WINDOW_MS=60000

# ── WebSocket 连接鉴权(issue #61)──────────────────
# /agent namespace 握手段校验静态 token(client 经 VITE_WS_TOKEN 携带)。
# 留空 = 不鉴权(开发默认,启动时打 warn);上线必须设为随机字符串。
# 浏览器端 token 可见,仅防"随手刷 LLM 额度",JWT 待用户系统再议(见 docs/deploy.md)。
WS_TOKEN=
