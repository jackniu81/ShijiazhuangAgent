# ── LLM ──────────────────────────────────────────
# mock(默认,无需外部依赖) | siliconflow | ollama
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=60000

# SiliconFlow(云端,provider=siliconflow 时生效)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# Ollama(本地,provider=ollama 时生效,需本机 ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=bge-m3

# ── RAG ──────────────────────────────────────────
# 默认指向仓库根 data/;跨目录部署时用绝对路径覆盖
DATA_DIR=
RAG_TOPK=5
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# ── 会话 ─────────────────────────────────────────
CHAT_HISTORY_TURNS=6
# 闲置会话回收时间(毫秒),默认 30 分钟
CHAT_SESSION_TTL_MS=1800000
# 提问最大长度,超出报 INVALID_INPUT
CHAT_QUESTION_MAX=500
