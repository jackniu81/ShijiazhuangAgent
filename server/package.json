{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API + static host for the React client",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p ../packages/shared/tsconfig.json && nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.17",
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/websockets": "^12.1.0",
    "@shijiazhuang-agent/shared": "*",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.13",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@shijiazhuang-agent/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    },
    "testEnvironment": "node"
  }
}
